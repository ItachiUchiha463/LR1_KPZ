# Скопіюйте цей файл у .env і підставте свій рядок підключення.
#
# MongoDB Atlas (хмара):
#   Atlas -> Database -> Connect -> Drivers -> Python
#   Не забудьте Network Access -> Add IP Address (інакше зʼєднання
#   відхиляється ще до автентифікації).
#   Якщо в паролі є символи @ : / ? # [ ] - їх треба URL-encode.
#
# MONGO_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
#
# Локальний MongoDB (через MongoDB Compass / mongod / Docker):
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=expert_system
